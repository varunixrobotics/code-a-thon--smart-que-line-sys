# Copy to .env and fill in. `npm start` loads it automatically.

# Port the server listens on
PORT=3000

# Required in production: at least 32 random characters.
# Used to sign short-lived tokens and to encrypt authenticator secrets at rest.
# In development a secret is generated once and stored in data/.app-secret.
APP_SECRET=

# Optional: enables "Sign in with Google" (Original OAuth 2.0).
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your site
# (e.g. http://localhost:3000) under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Supabase Auth Integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# First admin account (created on first start if no admin exists).
# If left empty in development, a random password is printed to the console once.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 1 when running behind a reverse proxy (nginx, Render, Railway…)
TRUST_PROXY=0

# Public URL when behind a proxy, used for the CSRF origin check (e.g. https://queue.example.com)
PUBLIC_ORIGIN=

# 1 = simulated walk-ins and counters so the live screens move during a demo.
# Defaults to on in development and off in production.
DEMO_MODE=

# production enables Secure/__Host- cookies, HSTS and requires APP_SECRET
NODE_ENV=development
